#!/bin/bash
set -euo pipefail
IFS=$'\n\t'
set -o xtrace

gcloud compute instances create kt128 --zone=us-central1-b --machine-type=c4-standard-4 --min-cpu-platform 'Intel Emerald Rapids' --image-project 'debian-cloud' --image-family 'debian-12'
until gcloud compute ssh kt128 --zone=us-central1-b --command 'pwd' ; do
  echo "Instance not fully available, retrying in 5 seconds..."
  sleep 5
done
gcloud compute ssh kt128 --zone=us-central1-b --command 'sudo apt-get install git -y'
# shellcheck disable=SC2016
gcloud compute ssh kt128 --zone=us-central1-b --command '
  set -euo pipefail
  go_version="$(wget -qO- "https://go.dev/VERSION?m=text" | sed -n "1p")"
  if ! printf "%s\n" "$go_version" | grep -Eq "^go[0-9]+\.[0-9]+\.[0-9]+$"; then
    printf "invalid Go version: %s\n" "$go_version" >&2
    exit 1
  fi
  archive="${go_version}.linux-amd64.tar.gz"
  wget -q "https://go.dev/dl/${archive}" -O "/tmp/${archive}"
  sudo rm -rf /usr/local/go
  sudo tar -C /usr/local -xzf "/tmp/${archive}"
  /usr/local/go/bin/go version
'
gcloud compute ssh kt128 --zone=us-central1-b --command "echo 'export PATH=\"/usr/local/go/bin:\$HOME/.local/bin:\$PATH\"' >> ~/.bashrc"
gcloud compute ssh kt128 --zone=us-central1-b --command 'git clone https://github.com/codahale/kt128'
# shellcheck disable=SC2016
gcloud compute ssh kt128 --zone=us-central1-b --command 'mkdir -p "$HOME/.local/bin" && GOBIN="$HOME/.local/bin" /usr/local/go/bin/go install golang.org/x/perf/cmd/benchstat@latest'
